# The one place each pinned tool and toolchain version is written (the pinning
# rule in .github/workflows/ci.yml's header). gate.sh, ci/toolchains.sh,
# ci/gitleaks-install.sh, ci/chrome-install.sh and the parent directory's
# bootstrap.sh source this file; gate.sh checks every copy a workflow or
# ci/geiger-baseline.txt has to hold against it. CONTRIBUTING.md ("Pins and the weekly refresh") says how to
# move one. Lines are comments, blank, or KEY=value with nothing to expand,
# each key one that ci/check-pins.sh lists: every reader runs it first, and it
# refuses any other line.

# Rust. RUST_STABLE is what rust-toolchain.toml's `channel = "stable"` must give
# a checkout and what CI installs; RUST_NIGHTLY is the dated nightly that
# cargo-udeps, fuzzing, cargo-careful and Miri run on.
RUST_STABLE=1.99.1
RUST_NIGHTLY=nightly-2026-10-27

# Cargo tools, each named after its crate.
CARGO_NEXTEST=0.9.150
CARGO_LLVM_COV=0.9.1
CARGO_UDEPS=0.1.61
CARGO_DENY=0.20.2
CARGO_AUDIT=0.22.2
CARGO_MACHETE=0.9.2
CARGO_VET=0.10.3
CARGO_MUTANTS=27.1.0
CARGO_FUZZ=0.13.2
CARGO_CAREFUL=0.4.10
# Moves only with ci/geiger-baseline.txt's counts (its header says how).
CARGO_GEIGER=0.14.0
# release.yml's build job.
CARGO_AUDITABLE=0.7.7
CARGO_CYCLONEDX=0.5.9
# bootstrap.sh only; nothing in CI or the gate runs it.
CARGO_SEMVER_CHECKS=0.51.0

# typos (the typos-cli crate).
TYPOS=1.51.1

# semgrep: the release, and the index digest of its image on Docker Hub, which
# ci.yml's semgrep job pulls by both.
SEMGREP=1.182.0
SEMGREP_IMAGE_DIGEST=sha256:4a34048c04fef049f71665047f074cffb00cc3d89482f965a5cd151d589237af

# gitleaks: the release, and the SHA-256 of its linux_x64 tarball as the
# release's checksums file gives it.
GITLEAKS=8.30.1
GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# The Codecov CLI that ci.yml's codecov job asks codecov-action for.
CODECOV_CLI=11.3.2

# ci.yml's net-cross job, CI only: the Android NDK (its version as the runner
# image's $ANDROID_HOME/ndk names it; r30, released 2026-09-08) and the Xcode
# that builds for iOS (the newest on the macos-latest image; Xcode 27.1
# qualifies but is only on a preview image).
ANDROID_NDK=30.0.16248370
XCODE=26.6

# nightly.yml's webtransport-chrome job only (spike B): Chrome for Testing,
# Stable 156.0.8078.80 (2026-10-28, the zips' Last-Modified), and the SHA-256
# of its linux64 chrome and chromedriver zips (ci/chrome-install.sh says how
# they were taken and how to move them); and wasm-bindgen-cli, which must be
# the version browser-tests/webtransport's wasm-bindgen pins (gate.sh checks).
CHROME_FOR_TESTING=156.0.8078.80
CHROME_LINUX64_SHA256=b711c720f774be355197f32edf37e0651418ba036d92446ee2da19ac017540a7
CHROMEDRIVER_LINUX64_SHA256=cae58bbd262ba5c8a0ce2540f44254b6e789efc4fe9b18bbb4a00487a9f5859e
WASM_BINDGEN_CLI=0.2.129
